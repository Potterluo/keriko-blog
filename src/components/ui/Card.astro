---
import type { HTMLAttributes } from "astro/types";

type CardElement = "article" | "aside" | "div" | "figure" | "header" | "nav" | "ol" | "section";

interface Props extends HTMLAttributes<"div"> {
  as?: CardElement;
}

const { as: Element = "div", class: className, ...attributes } = Astro.props;
---

<Element {...attributes} class:list={["rounded-panel border border-border bg-panel", className]}>
  <slot />
</Element>
