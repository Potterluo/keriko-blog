---
// 看板娘：自托管的透明视频动画。素材来自 dsh-pet（109 段），交互约定参考 live2d-widget。
// 素材与署名见 public/pet/README.md，形象许可 CC BY-NC-SA 4.0。
---

<div
  class="pet-root pointer-events-none fixed bottom-4 left-4 z-30 hidden select-none tablet:block"
  data-pet
  data-pet-ready
  transition:persist="blog-pet"
>
  <!-- 说话时一起出气泡和表情包：表情包贴右侧，像 dsh-pet 的碎碎念 -->
  <div class="mb-2 flex items-end gap-2" data-pet-speech hidden>
    <div
      class="rounded-2xl max-w-48 border border-border bg-panel px-3 py-2 text-xs leading-relaxed text-text-soft shadow-sm"
    >
      <span data-pet-bubble-text></span>
    </div>
    <img
      class="rounded-xl mb-1 size-20 shrink-0 border border-border bg-panel object-cover shadow-sm"
      data-pet-meme
      alt=""
      width="80"
      height="80"
      hidden
    />
  </div>

  <!--
    源片是 640×360 的透明视频，角色只占中间一块，而且每段的构图不一样
    （实测 109 段的包围盒从 218×274 到 628×308 都有）。
    所以不写死裁切框，改成每段按 manifest 里的包围盒换算缩放与偏移，见 frame()。
    窗口固定 240×252，按高度适配：角色高度恒定，宽的道具居中溢出。
    两个 video 轮流出镜：正面在播，背面把下一段 load 好，切换时直接换人。
  -->
  <div class="pointer-events-auto relative w-[240px]" data-pet-stage>
    <div class="relative h-[252px] w-full overflow-hidden" data-pet-window>
      <video
        class="pointer-events-none absolute top-0 left-0 max-w-none opacity-0"
        data-pet-video
        muted
        playsinline
        preload="auto"
        disablepictureinpicture
        disableRemotePlayback
        aria-hidden="true"></video>
      <video
        class="pointer-events-none absolute top-0 left-0 max-w-none opacity-0"
        data-pet-video
        muted
        playsinline
        preload="auto"
        disablepictureinpicture
        disableRemotePlayback
        aria-hidden="true"></video>
    </div>

    <a
      class="mt-1 block text-center text-[10px] text-muted-light no-underline transition-colors hover:text-accent-strong"
      href="https://github.com/PC2005-cloud/dsh-pet"
      target="_blank"
      rel="noreferrer">pet by dsh-pet</a
    >
  </div>
</div>

<style>
  /* 浏览器自带的画中画按钮浮在视频上，看着像坏了，一律藏掉 */
  [data-pet-video]::-webkit-media-controls,
  [data-pet-video]::-webkit-media-controls-enclosure,
  [data-pet-video]::-webkit-media-controls-overlay-play-button {
    display: none !important;
  }
</style>

<script>
  type Entry = {
    file: string;
    label: string;
    kind: string;
    size: number;
    cx?: number;
    cy?: number;
    bw?: number;
    bh?: number;
  };

  const MANIFEST = "/pet/manifest.json";
  const BASE = "/pet/";
  const IDLE: Entry = { file: "idle.webm", label: "待机呼吸休闲", kind: "idle", size: 0 };
  const QUOTES = [
    "欢迎来玩，随便逛逛。",
    "这里的每一篇都是慢慢写的。",
    "KV Cache 那几篇花的时间最久。",
    "按 Ctrl+K 可以搜文章。",
    "看累了就歇会儿。",
    "双击我可以睡觉。",
    "拖着我甩出去，我会弹回来。",
    "文章里有问题，欢迎到 GitHub 提。",
  ];
  const MEMES = Array.from({ length: 27 }, (_, i) => `/pet/memes/meme-${String(i + 1).padStart(2, "0")}.png`);

  const root = document.querySelector<HTMLElement>("[data-pet]");
  const stage = root?.querySelector<HTMLElement>("[data-pet-stage]");
  const windowEl = root?.querySelector<HTMLElement>("[data-pet-window]");
  const speech = root?.querySelector<HTMLElement>("[data-pet-speech]");
  const bubbleText = root?.querySelector<HTMLElement>("[data-pet-bubble-text]");
  const meme = root?.querySelector<HTMLImageElement>("[data-pet-meme]");
  const videos = Array.from(root?.querySelectorAll<HTMLVideoElement>("[data-pet-video]") ?? []);

  if (root && stage && windowEl && speech && bubbleText && meme && videos.length === 2) {
    const STORE_POS = "pet:pos";
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const isSafari = /^((?!chrome|android|crios|fxios).)*safari/i.test(navigator.userAgent);
    const supportsAlpha = !isSafari && videos[0].canPlayType('video/webm; codecs="vp9"') !== "";

    const petRoot = root;
    let entries: Entry[] = [];
    let front = 0; // 正在出镜的那个
    let frontFile = "";
    let staged: { el: HTMLVideoElement; file: string } | null = null;
    let sleeping = false;
    let lastMeme = -1;
    let idleTimer: number | undefined;
    let bubbleTimer: number | undefined;
    let squashTimer: number | undefined;
    let tiltRaf = 0;
    let raf = 0;
    let recent: string[] = [];

    let x = 16;
    let y = 0;
    let vx = 0;
    let vy = 0;
    let dragging = false;
    let hovering = false;
    let moved = false;
    let sample: { t: number; x: number; y: number }[] = [];

    const clamp = (value: number, max: number) => Math.max(8, Math.min(value, max));
    const maxX = () => window.innerWidth - petRoot.offsetWidth - 8;
    const maxY = () => window.innerHeight - petRoot.offsetHeight - 8;

    const apply = () => {
      petRoot.style.left = `${x}px`;
      petRoot.style.top = `${y}px`;
      petRoot.style.bottom = "auto";
    };

    const persist = () => {
      const rect = petRoot.getBoundingClientRect();
      localStorage.setItem(STORE_POS, JSON.stringify({ left: rect.left, top: rect.top }));
    };

    // —— 说话 ——

    const showMeme = () => {
      let index = Math.floor(Math.random() * MEMES.length);
      if (index === lastMeme) index = (index + 1) % MEMES.length;
      lastMeme = index;
      const src = MEMES[index];
      if (meme.getAttribute("src") !== src) meme.src = src;
      meme.hidden = false;
    };

    const say = (text: string, hold = 3600, withMeme = true) => {
      bubbleText.textContent = text;
      speech.hidden = false;
      if (withMeme && Math.random() < 0.75) showMeme();
      else meme.hidden = true;
      window.clearTimeout(bubbleTimer);
      bubbleTimer = window.setTimeout(() => {
        speech.hidden = true;
      }, hold);
    };

    // —— 挤压（只作用在窗口层，和悬停倾斜分开，互不覆盖）——

    const squash = (sx: number, sy: number) => {
      window.clearTimeout(squashTimer);
      windowEl.style.transition = "transform 90ms cubic-bezier(0.3, 0.8, 0.4, 1)";
      windowEl.style.transform = `scale(${sx}, ${sy})`;
      squashTimer = window.setTimeout(() => {
        windowEl.style.transform = "scale(1, 1)";
      }, 90);
    };

    // —— 播放：正面在播，背面预载，切换只换人 ——

    const back = () => videos[1 - front];

    const loadInto = (el: HTMLVideoElement, file: string) => {
      if (el.dataset.clip === file) return;
      el.dataset.clip = file;
      el.pause();
      el.src = BASE + file;
      el.load();
    };

    const WIN_W = 240;
    const WIN_H = 252;

    // 每段按自己的包围盒换算：按高度适配，中心对到窗口中心。
    // 这样角色高度恒定，道具（花、蝴蝶、烟花）居中溢出，不会把角色切掉。
    const frame = (el: HTMLVideoElement, entry: Entry) => {
      const bh = entry.bh && entry.bh > 0 ? entry.bh : 274;
      const cx = entry.cx ?? 320;
      const cy = entry.cy ?? 195;
      const scale = WIN_H / bh;
      el.style.width = `${Math.round(640 * scale)}px`;
      el.style.left = `${Math.round(WIN_W / 2 - cx * scale)}px`;
      el.style.top = `${Math.round(WIN_H / 2 - cy * scale)}px`;
    };

    const show = (entry: Entry, loop = false) => {
      if (frontFile === entry.file) {
        videos[front].loop = loop;
        void videos[front].play().catch(() => {});
        return;
      }
      const el = staged?.file === entry.file && staged.el === back() ? staged.el : back();
      if (el !== staged?.el || staged?.file !== entry.file) loadInto(el, entry.file);
      staged = null;

      const go = () => {
        if (el.dataset.clip !== entry.file) return;
        frame(el, entry);
        el.loop = loop;
        el.currentTime = 0;
        void el.play().catch(() => {});
        // 先让新的上屏，再把旧的停掉，中间不留空档
        el.style.opacity = "1";
        videos[front].style.opacity = "0";
        videos[front].pause();
        front = videos.indexOf(el);
        frontFile = entry.file;
        void stageNext();
      };
      if (el.readyState >= 2) go();
      else el.addEventListener("canplay", go, { once: true });
    };

    const idle = () => show(IDLE, true);

    const pool = () => entries.filter((e) => !["sleep", "drag"].includes(e.kind) && e.file !== IDLE.file);

    const pick = (candidates: Entry[], count = 1) => {
      const picked: Entry[] = [];
      for (let i = 0; i < count && candidates.length; i++) {
        const fresh = candidates.filter((e) => !recent.includes(e.file));
        const from = fresh.length ? fresh : candidates;
        const chosen = from[Math.floor(Math.random() * from.length)];
        picked.push(chosen);
        recent = [...recent, chosen.file].slice(-14);
      }
      return picked;
    };

    // 把下一段悄悄装进背面，点的时候才不用等
    const stageNext = async () => {
      if (!entries.length || sleeping) return;
      const el = back();
      const [next, after] = pick(pool(), 2);
      if (!next) return;
      if (staged?.el === el && staged.file === next.file) return;
      if (el.dataset.clip === next.file) {
        staged = { el, file: next.file };
        return;
      }
      loadInto(el, next.file);
      staged = { el, file: next.file };
      if (after) void fetch(BASE + after.file, { cache: "force-cache" }).catch(() => {});
    };

    // 点一下优先用背面预载好的那段，没有才现抽
    const takeNext = () => staged?.file ?? pick(pool())[0]?.file;

    // —— 随机动作 ——

    const scheduleIdleAction = () => {
      window.clearTimeout(idleTimer);
      if (reduceMotion.matches || sleeping) return;
      const wait = 6000 + Math.random() * 9000;
      idleTimer = window.setTimeout(() => {
        if (document.visibilityState === "visible" && !sleeping) {
          const file = takeNext();
          const entry = entries.find((e) => e.file === file);
          if (entry) show(entry);
        }
        scheduleIdleAction();
      }, wait);
    };

    const wake = () => {
      sleeping = false;
      const out = entries.find((e) => e.file === "sleep-out.webm");
      if (out) show(out);
      else idle();
      scheduleIdleAction();
    };

    const sleep = () => {
      sleeping = true;
      const inClip = entries.find((e) => e.file === "sleep-in.webm");
      if (inClip) show(inClip);
      else idle();
      say("那我睡一会儿…", 2600);
      window.clearTimeout(idleTimer);
    };

    // —— 悬停：倾斜作用在 stage 上，和挤压互不干扰 ——

    const resetTilt = () => {
      window.cancelAnimationFrame(tiltRaf);
      stage.style.transition = "transform 180ms ease-out";
      stage.style.transform = "rotate(0deg) translateY(0)";
    };

    stage.addEventListener("pointerenter", () => {
      hovering = true;
      stage.style.transition = "transform 160ms ease-out";
      stage.style.transform = "translateY(-3px)";
    });

    stage.addEventListener("pointerleave", () => {
      hovering = false;
      resetTilt();
    });

    window.addEventListener(
      "pointermove",
      (event) => {
        if (!hovering || dragging) return;
        window.cancelAnimationFrame(tiltRaf);
        tiltRaf = window.requestAnimationFrame(() => {
          const rect = stage.getBoundingClientRect();
          const nx = Math.max(-1, Math.min(1, (event.clientX - (rect.left + rect.width / 2)) / (rect.width / 2 + 120)));
          const ny = Math.max(
            -1,
            Math.min(1, (event.clientY - (rect.top + rect.height / 2)) / (rect.height / 2 + 120)),
          );
          stage.style.transform = `rotate(${(nx * 3).toFixed(2)}deg) translateY(${(-3 + ny * 2).toFixed(1)}px)`;
        });
      },
      { passive: true },
    );

    window.addEventListener("keydown", (event) => {
      if (!hovering) return;
      if (event.key === "s" || event.key === "S") {
        event.preventDefault();
        if (!sleeping) sleep();
      } else if (event.key === "Escape" && sleeping) {
        wake();
      }
    });

    // —— 拖拽与物理 ——

    stage.addEventListener("pointerdown", (event) => {
      if (event.button !== 0) return;
      window.cancelAnimationFrame(raf);
      resetTilt();
      vx = 0;
      vy = 0;
      dragging = true;
      moved = false;
      const rect = petRoot.getBoundingClientRect();
      x = rect.left;
      y = rect.top;
      sample = [{ t: performance.now(), x: event.clientX, y: event.clientY }];
      stage.setPointerCapture(event.pointerId);
    });

    stage.addEventListener("pointermove", (event) => {
      if (!dragging) return;
      const last = sample[sample.length - 1];
      const dx = event.clientX - last.x;
      const dy = event.clientY - last.y;
      if (Math.abs(event.clientX - sample[0].x) + Math.abs(event.clientY - sample[0].y) > 6) moved = true;
      x = clamp(x + dx, maxX());
      y = clamp(y + dy, maxY());
      apply();
      sample.push({ t: performance.now(), x: event.clientX, y: event.clientY });
      if (sample.length > 6) sample.shift();
    });

    stage.addEventListener("pointerup", (event) => {
      if (!dragging) return;
      dragging = false;
      stage.releasePointerCapture(event.pointerId);

      if (moved) {
        const first = sample[0];
        const last = sample[sample.length - 1];
        const dt = Math.max(16, last.t - first.t);
        vx = Math.max(-3, Math.min(3, (last.x - first.x) / dt));
        vy = Math.max(-3, Math.min(3, (last.y - first.y) / dt));
        if (Math.abs(vx) > 0.08 || Math.abs(vy) > 0.08) fling();
        else persist();
        return;
      }

      if (sleeping) {
        wake();
        return;
      }

      squash(1.1, 0.9);
      const file = takeNext();
      const entry = entries.find((e) => e.file === file);
      if (entry) show(entry);
      say(QUOTES[Math.floor(Math.random() * QUOTES.length)]);
    });

    stage.addEventListener("dblclick", () => {
      if (sleeping) wake();
      else sleep();
    });

    const fling = () => {
      window.cancelAnimationFrame(raf);
      let last = 0;
      let lastImpact = 0;
      const gravity = 0.0026;
      const bounce = 0.58;
      const friction = 0.994;

      const step = (ts: number) => {
        const dt = last ? Math.min(34, ts - last) : 16;
        last = ts;
        x += vx * dt;
        y += vy * dt;
        vy += gravity * dt;

        if (x < 8 || x > maxX()) {
          x = x < 8 ? 8 : maxX();
          vx = -vx * bounce;
          if (Math.abs(vx) > 0.3 && ts - lastImpact > 120) {
            squash(1.08, 0.92);
            lastImpact = ts;
          }
        }
        if (y < 8) {
          y = 8;
          vy = -vy * bounce;
        } else if (y > maxY()) {
          y = maxY();
          vy = -vy * bounce * 0.85;
          vx *= 0.92;
          if (Math.abs(vy) > 0.35 && ts - lastImpact > 120) {
            squash(1.14, 0.86);
            lastImpact = ts;
          }
        }

        vx *= friction;
        vy *= friction;
        apply();

        if (Math.abs(vx) < 0.02 && Math.abs(vy) < 0.02 && y >= maxY() - 1.5) {
          vx = 0;
          vy = 0;
          persist();
          return;
        }
        raf = window.requestAnimationFrame(step);
      };
      raf = window.requestAnimationFrame(step);
    };

    // 只有出镜的那个播完才继续，背面那些残留的 ended 一律不管
    videos.forEach((el) => {
      el.addEventListener("ended", () => {
        if (el !== videos[front]) return;
        if (sleeping) {
          const loopClip = entries.find((e) => e.file === "sleep-loop.webm");
          if (loopClip) show(loopClip, true);
          return;
        }
        idle();
      });
    });

    window.addEventListener("resize", () => {
      x = clamp(x, maxX());
      y = clamp(y, maxY());
      apply();
    });

    const start = async () => {
      if (!supportsAlpha) {
        petRoot.remove();
        return;
      }

      const saved = localStorage.getItem(STORE_POS);
      if (saved) {
        try {
          const pos = JSON.parse(saved) as { left: number; top: number };
          x = pos.left;
          y = pos.top;
        } catch {
          localStorage.removeItem(STORE_POS);
        }
      } else {
        const rect = petRoot.getBoundingClientRect();
        x = rect.left;
        y = rect.top;
      }
      apply();

      const el = videos[0];
      loadInto(el, IDLE.file);
      frame(el, IDLE);
      el.loop = true;
      el.style.opacity = "1";
      void el.play().catch(() => {});
      front = 0;
      frontFile = IDLE.file;

      try {
        entries = await (await fetch(MANIFEST, { cache: "force-cache" })).json();
      } catch {
        entries = [];
      }
      void stageNext();
      scheduleIdleAction();
    };

    if (document.readyState === "complete") void start();
    else window.addEventListener("load", start, { once: true });
  }
</script>
